@model FestivalCine.Models.Reserva
@{
    ViewData["Title"] = "Reservar boletos";
}

<h1>Reservar boletos</h1>

<form asp-action="Crear" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="NombreAsistente" class="form-label"></label>
        <input asp-for="NombreAsistente" class="form-control" />
        <span asp-validation-for="NombreAsistente" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Correo" class="form-label"></label>
        <input asp-for="Correo" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PeliculaId" class="form-label">Película</label>
        <select asp-for="PeliculaId" class="form-select">
        <option value="">-- Selecciona --</option>
        @foreach (var p in (List<FestivalCine.Models.Pelicula>)ViewBag.ListaPeliculas)
            {
        <option value="@p.Id" data-precio="@p.PrecioBoleto.ToString(System.Globalization.CultureInfo.InvariantCulture)">@p.Titulo</option>
            }
        </select>
        <span asp-validation-for="PeliculaId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CantidadBoletos" class="form-label"></label>
        <input asp-for="CantidadBoletos" type="number" class="form-control" />
        <span asp-validation-for="CantidadBoletos" class="text-danger"></span>
    </div>
    <p class="fs-5">Total estimado: <strong id="totalEstimado">$ 0</strong></p>

    <button type="submit" class="btn btn-primary">Confirmar reserva</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/festival.js" asp-append-version="true"></script>
}